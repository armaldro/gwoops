# ---- Supabase ----------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Server-only. Never expose to the browser. Used by the allowlist admin path
# and the reminders cron.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---- App ---------------------------------------------------------------
# Used to build magic-link redirect URLs. In production set this to your
# deployed origin, e.g. https://nest.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the Vercel cron endpoint (/api/cron/reminders).
CRON_SECRET=change-me

# Comma-separated emails seeded into allowed_emails by supabase/seed.sql.
# These are the only people who can ever sign in until you invite more.
SEED_ALLOWED_EMAILS=you@example.com,partner@example.com
SEED_HOUSEHOLD_NAME=Our Homes
